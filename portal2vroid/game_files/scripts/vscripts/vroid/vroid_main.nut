//=============================================================================
// Portal 2 VRoid Avatar mod - runtime script.
// Loaded by mapspawn.nut on every map. Single player only.
//
// Console commands (aliases from cfg/vroid/vroid_aliases.cfg) call the
// VRoid_* functions below. State survives map changes through the
// "vroid_session_restore" alias. Startup defaults come from the Portal2VRoid app.
//=============================================================================

// Portal 2 runs mapspawn.nut twice: in the server VM (full API) and in the client VM
// (no Entities, no players). The client run happens after a save game is restored,
// which also wipes the server's scheduled events (our update loop), so use it to ask
// the server side to (re)start the mod.
if (!("Entities" in getroottable())) {
	if ("SendToConsole" in getroottable()) SendToConsole("vroid_kick\n");
	return;
}

if ("VRoid_Loaded" in getroottable()) return;
::VRoid_Loaded <- true;

IncludeScript("vroid/vroid_avatars"); // ::VRoidAvatars, ::VRoidDefaults (generated by the installer)

if (!("VRoidAvatars" in getroottable())) ::VRoidAvatars <- [];
if (!("VRoidDefaults" in getroottable()))
	::VRoidDefaults <- { avatar = 0, thirdperson = 0, dist = 120, up = 0, right = 0, step_dist = 10, step_up = 4, step_right = 4, manage_cheats = 1 };

::VRoid <- {
	avatar = ::VRoidDefaults.avatar,
	tp = ::VRoidDefaults.thirdperson,
	dist = ::VRoidDefaults.dist,
	up = ::VRoidDefaults.up,
	right = ::VRoidDefaults.right,

	booted = false,
	initialized = false,
	restored = false,
	bootTime = 0.0,
	wait = 0,

	chellModel = "models/player/chell/player.mdl",
	precached = {},
	failed = {},
	pcStage = 0,
	pcTries = 0,
	setTries = 0,

	tpApplied = -1,
	camDirty = true,
	cheatsByUs = false,

	tickId = 0,
	lastTick = -1.0,
	ticks = 0,
	lastError = ""
};

//-----------------------------------------------------------------------------
// helpers
//-----------------------------------------------------------------------------
::VRoid_Log <- function(msg) { printl("[VRoid] " + msg); }

// Maps whose scenery breaks with a third-person camera: start them in first person.
::VRoid_FirstPersonMaps <- { sp_a1_intro1 = true };

// Every console command is newline-terminated so consecutive commands never run together.
::VRoid_Cmd <- function(cmd) { SendToConsole(cmd + "\n"); }

::VRoid_Clamp <- function(x, lo, hi) {
	if (x < lo) return lo;
	if (x > hi) return hi;
	return x;
}

::VRoid_FindAvatar <- function(id) {
	foreach (a in ::VRoidAvatars) {
		if (a.id == id) return a;
	}
	return null;
}

::VRoid_AvatarName <- function(id) {
	local a = VRoid_FindAvatar(id);
	return (a == null) ? "Chell" : a.name;
}

::VRoid_ModelFor <- function(id) {
	local a = VRoid_FindAvatar(id);
	return (a == null) ? ::VRoid.chellModel : a.model;
}

::VRoid_IsAvatarModel <- function(m) {
	return m.tolower().find("models/vroid/") == 0;
}

::VRoid_StateArgs <- function() {
	local v = ::VRoid;
	return v.avatar + "," + v.tp + "," + v.dist + "," + v.up + "," + v.right;
}

// Messages go to the console only. (An on-screen game_text entity created from
// script ends up in save games without being properly spawned.)
::VRoid_Notify <- function(msg) {
	VRoid_Log(msg);
}

// Remember the current state for the rest of this game session (survives map loads).
::VRoid_SaveSession <- function() {
	VRoid_Cmd("alias vroid_session_restore \"script VRoid_Restore(" + VRoid_StateArgs() + ")\"");
}

//-----------------------------------------------------------------------------
// public commands (called from aliases / the pause menu)
//-----------------------------------------------------------------------------
::VRoid_Restore <- function(avatar, tp, dist, up, right) {
	local v = ::VRoid;
	v.restored = true;
	if (avatar != 0 && VRoid_FindAvatar(avatar) == null) avatar = 0;
	if (avatar != v.avatar) { v.pcStage = 0; v.pcTries = 0; }
	v.avatar = avatar;
	v.tp = tp ? 1 : 0;
	v.dist = VRoid_Clamp(dist, 20, 400);
	v.up = VRoid_Clamp(up, -64, 96);
	v.right = VRoid_Clamp(right, -96, 96);
	v.camDirty = true;
	VRoid_SaveSession();
}

::VRoid_SelectAvatarId <- function(id) {
	local v = ::VRoid;
	if (id != 0 && VRoid_FindAvatar(id) == null) id = 0;
	v.avatar = id;
	v.pcStage = 0;
	v.pcTries = 0;
	v.setTries = 0;
	if (id in v.failed) delete v.failed[id];
	VRoid_SaveSession();
	VRoid_Notify("Avatar: " + VRoid_AvatarName(id));
}

::VRoid_CycleAvatar <- function(dir) {
	local ids = [0];
	foreach (a in ::VRoidAvatars) ids.append(a.id);
	local idx = 0;
	foreach (i, id in ids) {
		if (id == ::VRoid.avatar) idx = i;
	}
	idx = (idx + dir + ids.len()) % ids.len();
	VRoid_SelectAvatarId(ids[idx]);
}

// Apply the camera right away (does not wait for the update loop).
::VRoid_ApplyCamera <- function() {
	local v = ::VRoid;
	if (v.tp) {
		VRoid_Cmd("sv_cheats 1");
		v.cheatsByUs = true;
		VRoid_Cmd("cam_collision 1; cam_snapto 1; cam_idealyaw 0; cam_idealpitch 0");
		VRoid_Cmd("cam_idealdist " + v.dist + "; cam_idealdistup " + v.up + "; cam_idealdistright " + v.right);
		VRoid_Cmd("thirdperson");
	} else {
		VRoid_Cmd("firstperson");
		if (v.cheatsByUs) VRoid_Cheats(false);
	}
	v.tpApplied = v.tp;
	v.camDirty = false;
}

::VRoid_SetThirdPerson <- function(on) {
	::VRoid.tp = on ? 1 : 0;
	VRoid_ApplyCamera();
	VRoid_SaveSession();
	VRoid_Notify(on ? "Third-person camera ON" : "Third-person camera OFF");
}

::VRoid_ToggleThirdPerson <- function() {
	VRoid_SetThirdPerson(::VRoid.tp ? 0 : 1);
}

// which: 0 = distance, 1 = height, 2 = side.  dir: +1 / -1
::VRoid_CamAdjust <- function(which, dir) {
	local v = ::VRoid;
	local d = ::VRoidDefaults;
	if (which == 0) v.dist = VRoid_Clamp(v.dist + dir * d.step_dist, 20, 400);
	else if (which == 1) v.up = VRoid_Clamp(v.up + dir * d.step_up, -64, 96);
	else v.right = VRoid_Clamp(v.right + dir * d.step_right, -96, 96);
	if (v.tp == 0) v.tp = 1; // show the change
	VRoid_ApplyCamera();
	VRoid_SaveSession();
	VRoid_Notify("Camera  distance " + v.dist + "   height " + v.up + "   side " + v.right);
}

::VRoid_CamReset <- function() {
	local v = ::VRoid;
	v.dist = ::VRoidDefaults.dist;
	v.up = ::VRoidDefaults.up;
	v.right = ::VRoidDefaults.right;
	if (v.tp) VRoid_ApplyCamera();
	VRoid_SaveSession();
	VRoid_Notify("Camera reset");
}

// Defaults for the next launch are set in the Portal2VRoid app (the game cannot
// safely write files). This only explains that.
::VRoid_SavePersistent <- function() {
	VRoid_Notify("Set startup defaults in the Portal2VRoid app (Save settings)");
}

::VRoid_Disable <- function() {
	local v = ::VRoid;
	v.avatar = 0;
	v.tp = 0;
	v.camDirty = true;
	VRoid_SaveSession();
	VRoid_Notify("VRoid mod: Chell, first person");
}

::VRoid_Status <- function() {
	local v = ::VRoid;
	VRoid_Log("avatar=" + VRoid_AvatarName(v.avatar) + " (" + v.avatar + ") thirdperson=" + v.tp +
		" dist=" + v.dist + " up=" + v.up + " right=" + v.right + " avatars installed=" + ::VRoidAvatars.len());
	foreach (a in ::VRoidAvatars) VRoid_Log("  [" + a.id + "] " + a.name + " -> " + a.model);
	local p = GetPlayer();
	VRoid_Log("player model now: " + (p == null ? "(no player)" : p.GetModelName()));
	VRoid_Log("ticks: " + v.ticks + (v.lastError != "" ? ("  last error: " + v.lastError) : ""));
	if (v.ticks == 0) VRoid_Log("NOT RUNNING: the update loop has not started on this map.");
}

//-----------------------------------------------------------------------------
// state machine (runs every 0.1 s, see VRoid_ChainTick)
//-----------------------------------------------------------------------------
::VRoid_Cheats <- function(on) {
	if (on) {
		VRoid_Cmd("sv_cheats 1");
		::VRoid.cheatsByUs = true;
	} else if (::VRoidDefaults.manage_cheats) {
		VRoid_Cmd("sv_cheats 0");
		::VRoid.cheatsByUs = false;
	}
}

::VRoid_SetPlayerModel <- function(p, model) {
	local mins = null;
	local maxs = null;
	try { mins = p.GetBoundingMins(); maxs = p.GetBoundingMaxs(); } catch (e) {}
	p.SetModel(model);
	if (mins != null) {
		try { p.SetSize(mins, maxs); } catch (e) {} // keep the player's collision box as it was
	}
	VRoid_Log("player model -> " + model);
}

// Source can only switch to a model that is precached on this map, and VScript in
// Portal 2 has no precache function. Spawning a throwaway prop of the model with a
// (cheat-protected) console command precaches it; then we delete the prop.
::VRoid_PrecacheStep <- function(model, avatar) {
	local v = ::VRoid;
	if (v.pcStage == 0) {
		VRoid_Cheats(true);
		v.pcStage = 1;
		v.wait = 2;
		return false;
	}
	if (v.pcStage == 1) {
		if (v.pcTries % 2 == 0) VRoid_Cmd("prop_dynamic_create " + avatar.short);
		else VRoid_Cmd("ent_create prop_dynamic model " + model + " targetname vroid_precache_prop");
		v.pcStage = 2;
		v.wait = 3;
		return false;
	}
	// stage 2: did a prop with this model appear?
	local found = [];
	local e = null;
	for (local n = 0; n < 32; n++) { // bounded: never loop forever
		e = Entities.FindByModel(e, model);
		if (e == null) break;
		if (e.GetClassname() == "prop_dynamic") found.append(e);
	}
	if (found.len() > 0) {
		foreach (f in found) f.Destroy();
		v.precached[model] <- true;
		v.pcStage = 0;
		return true;
	}
	v.pcTries++;
	if (v.pcTries >= 6) {
		v.failed[avatar.id] <- true;
		v.pcStage = 0;
		VRoid_Notify("VRoid: could not load '" + avatar.name + "' (" + model + "). Is it installed? Using Chell.");
		v.avatar = 0;
		VRoid_SaveSession();
		return false;
	}
	v.pcStage = 1;
	v.wait = 2;
	return false;
}

::VRoid_Process <- function(p) {
	local v = ::VRoid;
	if (v.wait > 0) { v.wait--; return; }

	// 1) player model
	local want = VRoid_ModelFor(v.avatar);
	local cur = p.GetModelName();
	if (cur.tolower() != want.tolower()) {
		if (v.avatar == 0 || (want in v.precached)) {
			v.setTries++;
			if (v.setTries > 5) {
				if (v.setTries == 6) VRoid_Notify("VRoid: the game would not switch the player model; giving up on this map.");
				return;
			}
			VRoid_SetPlayerModel(p, want);
			if (v.tp == 0 && v.cheatsByUs) VRoid_Cheats(false);
		} else {
			local a = VRoid_FindAvatar(v.avatar);
			if (a == null || (a.id in v.failed)) { v.avatar = 0; return; }
			VRoid_PrecacheStep(want, a);
			return;
		}
	} else {
		v.precached[want] <- true;
		v.setTries = 0;
	}

	// 2) camera
	if (v.tp != v.tpApplied || v.camDirty) {
		if (v.tp) {
			if (!v.cheatsByUs) { VRoid_Cheats(true); v.wait = 2; return; }
			VRoid_Cmd("cam_collision 1; cam_snapto 1; cam_idealyaw 0; cam_idealpitch 0");
			VRoid_Cmd("cam_idealdist " + v.dist + "; cam_idealdistup " + v.up + "; cam_idealdistright " + v.right);
			if (v.tpApplied != 1) VRoid_Cmd("thirdperson");
		} else {
			VRoid_Cmd("firstperson");
			if (v.tpApplied == 1 || v.cheatsByUs) VRoid_Cheats(false);
		}
		v.tpApplied = v.tp;
		v.camDirty = false;
	}
}

::VRoid_Tick <- function() {
	local p = GetPlayer();
	if (p == null || !p.IsValid()) return;
	local v = ::VRoid;

	if (!v.booted) {
		v.booted = true;
		v.bootTime = Time();
		local m = p.GetModelName();
		if (m != "" && !VRoid_IsAvatarModel(m)) v.chellModel = m;
		// Restore this session's state (no-op on the first map after launch).
		VRoid_Cmd("exec vroid/vroid_aliases");
		VRoid_Cmd("vroid_session_restore");
		return;
	}
	if (!v.initialized) {
		if (!v.restored && Time() - v.bootTime < 0.6) return;
		v.initialized = true;
		if (!v.restored) {
			// First map since the game started: installer defaults apply.
			v.restored = true;
			VRoid_SaveSession();
		}
		if (v.tp && (GetMapName().tolower() in ::VRoid_FirstPersonMaps)) {
			// The scenery here is drawn through hidden portals that only look right from
			// the player's eyes, so a third-person camera shows the bare room instead.
			v.tp = 0;
			VRoid_Log("this map's scenery only works in first person; press V for third person anyway");
		}
		VRoid_Log("active: avatar=" + VRoid_AvatarName(v.avatar) + ", third person=" + (v.tp ? "on" : "off"));
		v.wait = 3;
		return;
	}
	VRoid_Process(p);
}

// Update loop, driven by VRoid_ChainTick re-scheduling itself every 0.1 s.
::VRoid_SafeTick <- function() {
	local v = ::VRoid;
	local now = Time();
	if (v.lastTick >= 0 && now - v.lastTick < 0.08 && now >= v.lastTick) return;
	v.lastTick = now;
	v.ticks++;
	try {
		VRoid_Tick();
	} catch (e) {
		if (v.lastError != e + "") VRoid_Log("error: " + e);
		v.lastError = e + "";
	}
}

::VRoid_ChainTick <- function(id) {
	if (id != ::VRoid.tickId) return;
	VRoid_SafeTick();
	local w = Entities.FindByClassname(null, "worldspawn");
	if (w != null) EntFireByHandle(w, "RunScriptCode", "VRoid_ChainTick(" + id + ")", 0.1, null, null);
}

// The loop only uses a delayed input on worldspawn (a map entity that always exists);
// the mod creates no entities of its own that could end up in save games.
// Restart the update loop if it is not running (e.g. a save game restore removed it).
::VRoid_EnsureRunning <- function() {
	local v = ::VRoid;
	local now = Time();
	if (v.ticks == 0 || now < v.lastTick || now - v.lastTick > 0.5) {
		if (v.ticks > 0) VRoid_Log("update loop was stopped (save game loaded?); restarting");
		VRoid_StartTimer();
	}
}

::VRoid_StartTimer <- function() {
	::VRoid.tickId = RandomInt(1, 1000000000);
	local w = Entities.FindByClassname(null, "worldspawn");
	if (w == null) { VRoid_Log("worldspawn not found; mod inactive on this map"); return; }
	EntFireByHandle(w, "RunScriptCode", "VRoid_ChainTick(" + ::VRoid.tickId + ")", 0.1, null, null);
}

// Earlier versions created these helper entities; remove any that a save game restored.
foreach (leftover in ["vroid_timer", "vroid_text"]) {
	local e = null;
	for (local n = 0; n < 8; n++) {
		e = Entities.FindByName(null, leftover);
		if (e == null) break;
		e.Destroy();
	}
}

// Single player only: co-op uses the robot models and blocks third person.
if (GetMapName().tolower().find("mp_coop") != 0) {
	VRoid_StartTimer();
	VRoid_Log("loaded (" + ::VRoidAvatars.len() + " avatars installed) on " + GetMapName());
} else {
	VRoid_Log("co-op map: mod disabled");
}
