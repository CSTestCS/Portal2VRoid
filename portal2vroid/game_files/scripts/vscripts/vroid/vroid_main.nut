//=============================================================================
// Portal 2 VRoid Avatar mod - runtime script.
// Loaded by mapspawn.nut on every map. Single player only.
//
// Console commands (aliases from cfg/vroid/vroid_aliases.cfg) call the
// VRoid_* functions below. State survives map changes through the
// "vroid_session_restore" alias, and across game restarts through
// cfg/vroid_saved.cfg (written with con_logfile by "Save as default").
//=============================================================================

if ("VRoid_Loaded" in getroottable()) return;
::VRoid_Loaded <- true;

IncludeScript("vroid/vroid_avatars"); // ::VRoidAvatars, ::VRoidDefaults (generated by the installer)

if (!("VRoidAvatars" in getroottable())) ::VRoidAvatars <- [];
if (!("VRoidDefaults" in getroottable()))
	::VRoidDefaults <- { avatar = 0, thirdperson = 0, dist = 120, up = 0, right = 0, step_dist = 10, step_up = 4, step_right = 4, manage_cheats = 1 };

::VRoid <- {
	avatar = ::VRoidDefaults.avatar,
	tp = ::VRoidDefaults.thirdperson,
	dist = ::VRoidDefaults.dist,
	up = ::VRoidDefaults.up,
	right = ::VRoidDefaults.right,

	booted = false,
	initialized = false,
	restored = false,
	bootTime = 0.0,
	wait = 0,

	chellModel = "models/player/chell/player.mdl",
	precached = {},
	failed = {},
	pcStage = 0,
	pcTries = 0,

	tpApplied = -1,
	camDirty = true,
	cheatsByUs = false
};

//-----------------------------------------------------------------------------
// helpers
//-----------------------------------------------------------------------------
::VRoid_Log <- function(msg) { printl("[VRoid] " + msg); }

// Every console command is newline-terminated so consecutive commands never run together.
::VRoid_Cmd <- function(cmd) { SendToConsole(cmd + "\n"); }

::VRoid_Clamp <- function(x, lo, hi) {
	if (x < lo) return lo;
	if (x > hi) return hi;
	return x;
}

::VRoid_FindAvatar <- function(id) {
	foreach (a in ::VRoidAvatars) {
		if (a.id == id) return a;
	}
	return null;
}

::VRoid_AvatarName <- function(id) {
	local a = VRoid_FindAvatar(id);
	return (a == null) ? "Chell" : a.name;
}

::VRoid_ModelFor <- function(id) {
	local a = VRoid_FindAvatar(id);
	return (a == null) ? ::VRoid.chellModel : a.model;
}

::VRoid_IsAvatarModel <- function(m) {
	return m.tolower().find("models/vroid/") == 0;
}

::VRoid_StateArgs <- function() {
	local v = ::VRoid;
	return v.avatar + "," + v.tp + "," + v.dist + "," + v.up + "," + v.right;
}

::VRoid_Notify <- function(msg) {
	VRoid_Log(msg);
	local t = Entities.FindByName(null, "vroid_text");
	if (t == null) {
		t = Entities.CreateByClassname("game_text");
		if (t == null) return;
		t.__KeyValueFromString("targetname", "vroid_text");
		t.__KeyValueFromString("spawnflags", "1");
		t.__KeyValueFromString("x", "-1");
		t.__KeyValueFromString("y", "0.82");
		t.__KeyValueFromString("channel", "3");
		t.__KeyValueFromString("effect", "0");
		t.__KeyValueFromString("color", "255 220 140");
		t.__KeyValueFromString("fadein", "0.05");
		t.__KeyValueFromString("fadeout", "0.5");
		t.__KeyValueFromString("holdtime", "2.5");
	}
	t.__KeyValueFromString("message", msg);
	EntFireByHandle(t, "Display", "", 0.0, null, null);
}

// Remember the current state for the rest of this game session (survives map loads).
::VRoid_SaveSession <- function() {
	VRoid_Cmd("alias vroid_session_restore \"script VRoid_Restore(" + VRoid_StateArgs() + ")\"");
}

//-----------------------------------------------------------------------------
// public commands (called from aliases / the pause menu)
//-----------------------------------------------------------------------------
::VRoid_Restore <- function(avatar, tp, dist, up, right) {
	local v = ::VRoid;
	v.restored = true;
	if (avatar != 0 && VRoid_FindAvatar(avatar) == null) avatar = 0;
	if (avatar != v.avatar) { v.pcStage = 0; v.pcTries = 0; }
	v.avatar = avatar;
	v.tp = tp ? 1 : 0;
	v.dist = VRoid_Clamp(dist, 20, 400);
	v.up = VRoid_Clamp(up, -64, 96);
	v.right = VRoid_Clamp(right, -96, 96);
	v.camDirty = true;
	VRoid_SaveSession();
}

::VRoid_SelectAvatarId <- function(id) {
	local v = ::VRoid;
	if (id != 0 && VRoid_FindAvatar(id) == null) id = 0;
	v.avatar = id;
	v.pcStage = 0;
	v.pcTries = 0;
	if (id in v.failed) delete v.failed[id];
	VRoid_SaveSession();
	VRoid_Notify("Avatar: " + VRoid_AvatarName(id));
}

::VRoid_CycleAvatar <- function(dir) {
	local ids = [0];
	foreach (a in ::VRoidAvatars) ids.append(a.id);
	local idx = 0;
	foreach (i, id in ids) {
		if (id == ::VRoid.avatar) idx = i;
	}
	idx = (idx + dir + ids.len()) % ids.len();
	VRoid_SelectAvatarId(ids[idx]);
}

::VRoid_SetThirdPerson <- function(on) {
	::VRoid.tp = on ? 1 : 0;
	::VRoid.camDirty = true;
	VRoid_SaveSession();
	VRoid_Notify(on ? "Third-person camera ON" : "Third-person camera OFF");
}

::VRoid_ToggleThirdPerson <- function() {
	VRoid_SetThirdPerson(::VRoid.tp ? 0 : 1);
}

// which: 0 = distance, 1 = height, 2 = side.  dir: +1 / -1
::VRoid_CamAdjust <- function(which, dir) {
	local v = ::VRoid;
	local d = ::VRoidDefaults;
	if (which == 0) v.dist = VRoid_Clamp(v.dist + dir * d.step_dist, 20, 400);
	else if (which == 1) v.up = VRoid_Clamp(v.up + dir * d.step_up, -64, 96);
	else v.right = VRoid_Clamp(v.right + dir * d.step_right, -96, 96);
	v.camDirty = true;
	if (v.tp == 0) v.tp = 1; // show the change
	VRoid_SaveSession();
	VRoid_Notify("Camera  distance " + v.dist + "   height " + v.up + "   side " + v.right);
}

::VRoid_CamReset <- function() {
	local v = ::VRoid;
	v.dist = ::VRoidDefaults.dist;
	v.up = ::VRoidDefaults.up;
	v.right = ::VRoidDefaults.right;
	v.camDirty = true;
	VRoid_SaveSession();
	VRoid_Notify("Camera reset");
}

// Write the current state to cfg/vroid_saved.cfg so it is the default next launch.
::VRoid_SavePersistent <- function() {
	VRoid_Cmd("con_logfile cfg/vroid_saved.cfg");
	VRoid_Cmd("echo script VRoid_Restore(" + VRoid_StateArgs() + ")");
	VRoid_Cmd("con_logfile \"\"");
	VRoid_Notify("VRoid settings saved as default");
}

::VRoid_Disable <- function() {
	local v = ::VRoid;
	v.avatar = 0;
	v.tp = 0;
	v.camDirty = true;
	VRoid_SaveSession();
	VRoid_Notify("VRoid mod: Chell, first person");
}

::VRoid_Status <- function() {
	local v = ::VRoid;
	VRoid_Log("avatar=" + VRoid_AvatarName(v.avatar) + " (" + v.avatar + ") thirdperson=" + v.tp +
		" dist=" + v.dist + " up=" + v.up + " right=" + v.right + " avatars installed=" + ::VRoidAvatars.len());
	foreach (a in ::VRoidAvatars) VRoid_Log("  [" + a.id + "] " + a.name + " -> " + a.model);
}

//-----------------------------------------------------------------------------
// state machine (runs every 0.1 s from a logic_timer)
//-----------------------------------------------------------------------------
::VRoid_Cheats <- function(on) {
	if (on) {
		VRoid_Cmd("sv_cheats 1");
		::VRoid.cheatsByUs = true;
	} else if (::VRoidDefaults.manage_cheats) {
		VRoid_Cmd("sv_cheats 0");
		::VRoid.cheatsByUs = false;
	}
}

::VRoid_SetPlayerModel <- function(p, model) {
	local mins = p.GetBoundingMins();
	local maxs = p.GetBoundingMaxs();
	p.SetModel(model);
	p.SetSize(mins, maxs); // keep the player's collision box exactly as it was
}

// Source can only switch to a model that is precached on this map, and VScript in
// Portal 2 has no precache function. Spawning a throwaway prop of the model with a
// (cheat-protected) console command precaches it; then we delete the prop.
::VRoid_PrecacheStep <- function(model, avatar) {
	local v = ::VRoid;
	if (v.pcStage == 0) {
		VRoid_Cheats(true);
		v.pcStage = 1;
		v.wait = 2;
		return false;
	}
	if (v.pcStage == 1) {
		if (v.pcTries % 2 == 0) VRoid_Cmd("prop_dynamic_create " + avatar.short);
		else VRoid_Cmd("ent_create prop_dynamic model " + model + " targetname vroid_precache_prop");
		v.pcStage = 2;
		v.wait = 3;
		return false;
	}
	// stage 2: did a prop with this model appear?
	local found = [];
	local e = null;
	while ((e = Entities.FindByModel(e, model)) != null) {
		if (e.GetClassname() == "prop_dynamic") found.append(e);
	}
	if (found.len() > 0) {
		foreach (f in found) f.Destroy();
		v.precached[model] <- true;
		v.pcStage = 0;
		return true;
	}
	v.pcTries++;
	if (v.pcTries >= 6) {
		v.failed[avatar.id] <- true;
		v.pcStage = 0;
		VRoid_Notify("VRoid: could not load '" + avatar.name + "' (" + model + "). Is it installed? Using Chell.");
		v.avatar = 0;
		VRoid_SaveSession();
		return false;
	}
	v.pcStage = 1;
	v.wait = 2;
	return false;
}

::VRoid_Process <- function(p) {
	local v = ::VRoid;
	if (v.wait > 0) { v.wait--; return; }

	// 1) player model
	local want = VRoid_ModelFor(v.avatar);
	local cur = p.GetModelName();
	if (cur.tolower() != want.tolower()) {
		if (v.avatar == 0 || (want in v.precached)) {
			VRoid_SetPlayerModel(p, want);
			if (v.tp == 0 && v.cheatsByUs) VRoid_Cheats(false);
		} else {
			local a = VRoid_FindAvatar(v.avatar);
			if (a == null || (a.id in v.failed)) { v.avatar = 0; return; }
			VRoid_PrecacheStep(want, a);
			return;
		}
	} else {
		v.precached[want] <- true;
	}

	// 2) camera
	if (v.tp != v.tpApplied || v.camDirty) {
		if (v.tp) {
			if (!v.cheatsByUs) { VRoid_Cheats(true); v.wait = 2; return; }
			VRoid_Cmd("cam_collision 1; cam_snapto 1; cam_idealyaw 0; cam_idealpitch 0");
			VRoid_Cmd("cam_idealdist " + v.dist + "; cam_idealdistup " + v.up + "; cam_idealdistright " + v.right);
			if (v.tpApplied != 1) VRoid_Cmd("thirdperson");
		} else {
			VRoid_Cmd("firstperson");
			if (v.tpApplied == 1 || v.cheatsByUs) VRoid_Cheats(false);
		}
		v.tpApplied = v.tp;
		v.camDirty = false;
	}
}

::VRoid_Tick <- function() {
	local p = GetPlayer();
	if (p == null || !p.IsValid()) return;
	local v = ::VRoid;

	if (!v.booted) {
		v.booted = true;
		v.bootTime = Time();
		local m = p.GetModelName();
		if (m != "" && !VRoid_IsAvatarModel(m)) v.chellModel = m;
		// Restore this session's state (no-op on the first map after launch).
		VRoid_Cmd("exec vroid/vroid_aliases");
		VRoid_Cmd("vroid_session_restore");
		return;
	}
	if (!v.initialized) {
		if (!v.restored && Time() - v.bootTime < 0.6) return;
		v.initialized = true;
		if (!v.restored) {
			// First map since the game started: apply installer defaults, keybinds
			// and anything saved in-game with "Save as default".
			v.restored = true;
			VRoid_Cmd("exec vroid/vroid_binds");
			VRoid_Cmd("exec vroid_saved");
			VRoid_SaveSession();
		}
		v.wait = 3;
		return;
	}
	VRoid_Process(p);
}

::VRoid_StartTimer <- function() {
	if (Entities.FindByName(null, "vroid_timer") != null) return;
	local t = Entities.CreateByClassname("logic_timer");
	if (t == null) { VRoid_Log("could not create timer"); return; }
	t.__KeyValueFromString("targetname", "vroid_timer");
	EntFireByHandle(t, "AddOutput", "RefireTime 0.1", 0.0, null, null);
	EntFireByHandle(t, "AddOutput", "OnTimer vroid_timer:RunScriptCode:VRoid_Tick():0:-1", 0.0, null, null);
	EntFireByHandle(t, "Enable", "", 0.2, null, null);
}

// Single player only: co-op uses the robot models and blocks third person.
if (GetMapName().tolower().find("mp_coop") != 0) {
	VRoid_StartTimer();
	VRoid_Log("loaded (" + ::VRoidAvatars.len() + " avatars installed)");
}
